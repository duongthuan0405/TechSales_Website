# Shared configuration for all modules. Copy to .env and replace placeholders.
# Existing process environment variables take precedence.

# CommonModule

# AuthModule
AUTH__RateLimit__PermitLimit=20
AUTH__RateLimit__WindowMinutes=1
AUTH__DbConnectionString="Host=localhost;Port=5432;Database=techsales;Username=YOUR_USER;Password=YOUR_PASSWORD"
AUTH__JWT__SecretKey="REPLACE_WITH_RANDOM_BASE64_KEY"
AUTH__JWT__Issuer="TechSales"
AUTH__JWT__Audience="TechSalesClient"
AUTH__JWT__DurationInMinutes=60
# Optional links in verification/reset emails:
# AUTH__FrontendUrl="http://localhost:3000"
# One-time bootstrap after applying Auth migrations. Remove these after first startup.
# AUTH__Bootstrap__Email="YOUR_TECHNICAL_ADMIN_EMAIL"
# AUTH__Bootstrap__Password="YOUR_STRONG_PASSWORD"

# CatalogModule
CATALOG__DbConnectionString="Host=localhost;Port=5432;Database=techsales;Username=YOUR_USER;Password=YOUR_PASSWORD"

# InventoryModule
INVENTORY__DbConnectionString="Host=localhost;Port=5432;Database=techsales;Username=YOUR_USER;Password=YOUR_PASSWORD"

# CartModule
CART__DbConnectionString="Host=localhost;Port=5432;Database=techsales;Username=YOUR_USER;Password=YOUR_PASSWORD"

# OrderingModule
ORDERING__DbConnectionString="Host=localhost;Port=5432;Database=techsales;Username=YOUR_USER;Password=YOUR_PASSWORD"

# ShippingModule
SHIPPING__DbConnectionString="Host=localhost;Port=5432;Database=techsales;Username=YOUR_USER;Password=YOUR_PASSWORD"

# PromotionModule
PROMOTION__DbConnectionString="Host=localhost;Port=5432;Database=techsales;Username=YOUR_USER;Password=YOUR_PASSWORD"

# AfterSaleModule
AFTERSALE__DbConnectionString="Host=localhost;Port=5432;Database=techsales;Username=YOUR_USER;Password=YOUR_PASSWORD"

# PaymentRefundModule
PAYMENTREFUND__DbConnectionString="Host=localhost;Port=5432;Database=techsales;Username=YOUR_USER;Password=YOUR_PASSWORD"

# ReviewNotificationModule
REVIEWNOTIFICATION__DbConnectionString="Host=localhost;Port=5432;Database=techsales;Username=YOUR_USER;Password=YOUR_PASSWORD"

# MailModule
MAIL__DbConnectionString="Host=localhost;Port=5432;Database=techsales;Username=YOUR_USER;Password=YOUR_PASSWORD"
MAIL__Host="localhost"
MAIL__Port=587
MAIL__FromEmail="noreply@example.com"
MAIL__DisplayName="TechSales"
MAIL__Security="StartTls"
# MAIL__UserName="YOUR_SMTP_USER"
# MAIL__Password="YOUR_SMTP_PASSWORD"
