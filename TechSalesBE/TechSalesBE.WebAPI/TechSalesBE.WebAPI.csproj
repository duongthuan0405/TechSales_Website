<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
    <Content Update=".env;.env.*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update=".env;.env.*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\AuthModule\AuthModule.csproj" />
    <ProjectReference Include="..\Modules\CommonModule\CommonModule.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\ProductModule\ProductModule.csproj" />
    <ProjectReference Include="..\Modules\InventoryModule\InventoryModule.csproj" />
    <ProjectReference Include="..\Modules\CartModule\CartModule.csproj" />
    <ProjectReference Include="..\Modules\OrderingModule\OrderingModule.csproj" />
    <ProjectReference Include="..\Modules\ShippingModule\ShippingModule.csproj" />
    <ProjectReference Include="..\Modules\PromotionModule\PromotionModule.csproj" />
    <ProjectReference Include="..\Modules\AfterSaleModule\AfterSaleModule.csproj" />
    <ProjectReference Include="..\Modules\PaymentRefundModule\PaymentRefundModule.csproj" />
    <ProjectReference Include="..\Modules\ReviewNotificationModule\ReviewNotificationModule.csproj" />
    <ProjectReference Include="..\Modules\MailModule\MailModule.csproj" />
    <Folder Include="Integration\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
